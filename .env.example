# Logging
# Set to "1", "true", "yes" or "on" to enable logging.
# Set to "0", "false", "no" or "off" to disable it completely.
LOGGING_ENABLED=1

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Also print logs to the console (1 = yes, 0 = no)
LOG_TO_CONSOLE=1



#Activer les logs (défaut):→ Logs dans logs/screen_recorder.log et la console.
LOGGING_ENABLED=1
LOG_LEVEL=DEBUG
LOG_TO_CONSOLE=1


#Désactiver complètement les logs :→ Aucun log, aucun fichier créé. Les appels log.info(...) deviennent des no-op.
LOGGING_ENABLED=0


#Logs silencieux (fichier seulement, pas de console) :  :
LOGGING_ENABLED=1
LOG_LEVEL=INFO
LOG_TO_CONSOLE=0


#Logs minimaux (erreurs uniquement)
LOGGING_ENABLED=1
LOG_LEVEL=ERROR
LOG_TO_CONSOLE=1